# --- core ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cms_dev
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-string
WEBHOOK_SECRET=replace-with-another-long-random-string
CORS_ORIGINS=["http://localhost:3000"]
TIMEZONE=Asia/Kolkata

# --- court data provider: mock | ecourtsindia ---
COURT_PROVIDER=mock
ECOURTSINDIA_BASE_URL=https://webapi.ecourtsindia.com
ECOURTSINDIA_API_KEY=
# Indicative Enterprise rate card (INR / request) used for usage estimates
RATE_CASE_SEARCH=0.20
RATE_CASE_DETAIL=0.50
RATE_CASE_REFRESH=0.05
RATE_ORDER_PDF=1.25
RATE_CALL_MINUTE=1.00
SYNC_NOW_COOLDOWN_MINUTES=15
SYNC_REFRESH_SETTLE_MINUTES=10

# --- voice + sms: mock | exotel ---
VOICE_PROVIDER=mock
SMS_PROVIDER=mock
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_FLOW_URL=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
CALL_MAX_ATTEMPTS=3
CALL_RETRY_MINUTES=10

# --- email: mock | smtp ---
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@yourdomain.in

# --- storage: local | s3 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=ap-south-1
MAX_UPLOAD_MB=25
